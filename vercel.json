{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @vaultmcp/shared build && pnpm --filter @vaultmcp/api build && pnpm --filter @vaultmcp/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "apps/api/{dist,drizzle}/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/:path*", "destination": "/api/mcp/:path*" },
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/oauth/:path*", "destination": "/api/oauth/:path*" },
    { "source": "/.well-known/:path*", "destination": "/api/well-known/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
